# Frozen prompts are hashed byte for byte (manifest sha256): never convert their line endings.
bench/prompts/** -text
# Hetero receipts contain byte hashes of configs, prompts and raw model outputs.
# Keep their original bytes on Windows and on other checkouts.
bench/hetero/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Raw model/wire artifacts may intentionally contain blank lines or trailing spaces.
bench/hetero/**/requests/** -whitespace
bench/hetero/**/*.sse.txt -whitespace
# Native tool output is retained byte for byte, including its intentional padding.
bench/hetero/**/*.log -whitespace
# Executed benchmark helpers are retained as evidence with their original bytes.
bench/hetero/**/*.ps1 -whitespace

# launchers keep their platform line endings wherever the repository is cloned
*.sh text eol=lf
*.bat text eol=crlf

# copies of real packs' native_experts.txt, parsed byte for byte by tests/core/expert_layout_test.cpp
tests/data/native_experts/** -text
